// Copy to Config/Local.xcconfig (git ignores it) and fill in your own values.

// Your Apple Developer Team ID (developer.apple.com/account › Membership details,
// or the team shown in Xcode › Settings › Accounts).
DEVELOPMENT_TEAM = ABCDE12345

// Bundle ids are unique across Apple, so anyone besides the maintainer needs their own.
// Set gaca-api's GACA_APNS_TOPIC to the same value.
PRODUCT_BUNDLE_IDENTIFIER = com.example.gaca

// Free Apple ID (no paid developer team)? Apple doesn't allow push, so turn it off:
// CODE_SIGN_ENTITLEMENTS = Gaca/Resources/Basic.entitlements
// GACA_PUSH_ENABLED = NO
