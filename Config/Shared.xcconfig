// Settings shared by every configuration. The app ships without a server address:
// it pairs with one by scanning the QR code `gaca-api pair` prints.

// Signing is per person: put your own values in Config/Local.xcconfig (untracked;
// copy Local.xcconfig.example). These defaults build for the simulator as-is.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = dev.monts.gaca
// Push notifications are on by default, which needs a paid Apple Developer team.
// A free Apple ID can't sign push, so Local.xcconfig can switch to Basic.entitlements.
CODE_SIGN_ENTITLEMENTS = Gaca/Resources/Push.entitlements
GACA_PUSH_ENABLED = YES

#include? "Local.xcconfig"
